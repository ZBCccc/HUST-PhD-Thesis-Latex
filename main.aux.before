\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces 不同候选集规模下的搜索耗时（$n=3$，$k=10$，$M=2^{22}$）。图中展示服务器端搜索阶段（含证明生成）的耗时随候选集规模 $|\mathsf  {Cand}(w_s)|$ 的变化。搜索耗时随候选集规模近似线性增长，与理论分析的 $O(|\mathsf  {Cand}(w_s)| \cdot (n-1) \cdot (k\log M + \ell ))$ 复杂度一致}}{71}{figure.caption.26}\protected@file@percent }
\newlabel{fig:search-time}{{4.3}{71}{不同候选集规模下的搜索耗时（$n=3$，$k=10$，$M=2^{22}$）。图中展示服务器端搜索阶段（含证明生成）的耗时随候选集规模 $|\mathsf {Cand}(w_s)|$ 的变化。搜索耗时随候选集规模近似线性增长，与理论分析的 $O(|\mathsf {Cand}(w_s)| \cdot (n-1) \cdot (k\log M + \ell ))$ 复杂度一致}{figure.caption.26}{}}
\newlabel{fig:search-time@cref}{{[figure][3][4]4.3}{[1][70][]71}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces 不同候选集规模下的客户端验证耗时（$n=3$，$k=10$）。图中展示客户端验证阶段的耗时，包含 $\mathsf  {QTree}$ 路径验证与 Merkle-Open 选择性开封验证两部分。验证耗时约为服务器搜索耗时的 $0.6$--$0.8$ 倍，受 $N_+$ 与 $N_-$ 的比例影响}}{71}{figure.caption.27}\protected@file@percent }
\newlabel{fig:verify-time}{{4.4}{71}{不同候选集规模下的客户端验证耗时（$n=3$，$k=10$）。图中展示客户端验证阶段的耗时，包含 $\mathsf {QTree}$ 路径验证与 Merkle-Open 选择性开封验证两部分。验证耗时约为服务器搜索耗时的 $0.6$--$0.8$ 倍，受 $N_+$ 与 $N_-$ 的比例影响}{figure.caption.27}{}}
\newlabel{fig:verify-time@cref}{{[figure][4][4]4.4}{[1][70][]71}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces 不同合取关键词数下的单次查询通信量（$|\mathsf  {Cand}|=1000$，$k=10$）。图中对比 Nomos 方案与本文方案在不同合取关键词数 $n$ 下的通信开销。本文方案的额外通信量主要来自 $\mathsf  {QTree}$ 认证路径（$O(k\log M)$）与 Merkle-Open 选择性开封（$O(k(|\mathbb  {G}|+\lambda \log \ell ))$），随 $n$ 线性增长}}{72}{figure.caption.28}\protected@file@percent }
\newlabel{fig:comm-overhead}{{4.5}{72}{不同合取关键词数下的单次查询通信量（$|\mathsf {Cand}|=1000$，$k=10$）。图中对比 Nomos 方案与本文方案在不同合取关键词数 $n$ 下的通信开销。本文方案的额外通信量主要来自 $\mathsf {QTree}$ 认证路径（$O(k\log M)$）与 Merkle-Open 选择性开封（$O(k(|\mathbb {G}|+\lambda \log \ell ))$），随 $n$ 线性增长}{figure.caption.28}{}}
\newlabel{fig:comm-overhead@cref}{{[figure][5][4]4.5}{[1][70][]72}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces 不同数据规模下的服务器端存储开销（$\ell =20$，$M=2^{22}$）。图中对比 Nomos 方案与本文方案在不同 $N$ 值下的存储需求。本文方案的额外存储主要来自 $\mathsf  {QTree}$ 节点（$O(M\cdot \lambda )$）与承诺嵌入（$O(N\cdot \lambda )$），均为线性增量}}{72}{figure.caption.29}\protected@file@percent }
\newlabel{fig:storage-overhead}{{4.6}{72}{不同数据规模下的服务器端存储开销（$\ell =20$，$M=2^{22}$）。图中对比 Nomos 方案与本文方案在不同 $N$ 值下的存储需求。本文方案的额外存储主要来自 $\mathsf {QTree}$ 节点（$O(M\cdot \lambda )$）与承诺嵌入（$O(N\cdot \lambda )$），均为线性增量}{figure.caption.29}{}}
\newlabel{fig:storage-overhead@cref}{{[figure][6][4]4.6}{[1][70][]72}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces 参数 $\ell $ 对更新耗时与开封通信量的影响（$M=2^{22}$，$N=10^5$）。图中展示更新耗时与开封通信量随 $\ell $ 的变化。更新耗时随 $\ell $ 线性增长（$O(\ell \log M)$），开封通信量同样线性增长（$O(\ell \cdot |\mathbb  {G}|)$），验证了理论预测}}{73}{figure.caption.30}\protected@file@percent }
\newlabel{fig:param-ell}{{4.7}{73}{参数 $\ell $ 对更新耗时与开封通信量的影响（$M=2^{22}$，$N=10^5$）。图中展示更新耗时与开封通信量随 $\ell $ 的变化。更新耗时随 $\ell $ 线性增长（$O(\ell \log M)$），开封通信量同样线性增长（$O(\ell \cdot |\mathbb {G}|)$），验证了理论预测}{figure.caption.30}{}}
\newlabel{fig:param-ell@cref}{{[figure][7][4]4.7}{[1][70][]73}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces 参数 $k$ 对证明生成与验证耗时的影响（$|\mathsf  {Cand}|=1000$，$n=3$，$M=2^{22}$）。图中展示证明生成与客户端验证耗时随 $k$ 的变化。两者均随 $k$ 线性增长（$O(k\log M)$），与理论分析一致。$k$ 的增大提高查询侧的检验覆盖度，但增大验证开销}}{73}{figure.caption.31}\protected@file@percent }
\newlabel{fig:param-k}{{4.8}{73}{参数 $k$ 对证明生成与验证耗时的影响（$|\mathsf {Cand}|=1000$，$n=3$，$M=2^{22}$）。图中展示证明生成与客户端验证耗时随 $k$ 的变化。两者均随 $k$ 线性增长（$O(k\log M)$），与理论分析一致。$k$ 的增大提高查询侧的检验覆盖度，但增大验证开销}{figure.caption.31}{}}
\newlabel{fig:param-k@cref}{{[figure][8][4]4.8}{[1][70][]73}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces $\mathsf  {XSet}$ 位数组长度 $M$ 对 $\mathsf  {QTree}$ 初始化耗时与路径长度的影响。图中展示 $\mathsf  {QTree}$ 初始化耗时与单条认证路径长度随 $M$ 的变化。初始化耗时随 $M$ 线性增长（$O(M)$），路径长度随 $M$ 对数增长（$O(\log M)$），验证了理论预测}}{74}{figure.caption.32}\protected@file@percent }
\newlabel{fig:param-M}{{4.9}{74}{$\mathsf {XSet}$ 位数组长度 $M$ 对 $\mathsf {QTree}$ 初始化耗时与路径长度的影响。图中展示 $\mathsf {QTree}$ 初始化耗时与单条认证路径长度随 $M$ 的变化。初始化耗时随 $M$ 线性增长（$O(M)$），路径长度随 $M$ 对数增长（$O(\log M)$），验证了理论预测}{figure.caption.32}{}}
\newlabel{fig:param-M@cref}{{[figure][9][4]4.9}{[1][74][]74}{}{}{}}
