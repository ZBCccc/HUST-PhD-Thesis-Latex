\@writefile{lot}{\contentsline {table}{\numberline {1.1}{\ignorespaces 代表性可验证 SSE 方案技术对比。表中 $N$ 为文件-关键词对总数，$|\mathsf  {Res}|$ 为结果集规模，$\lambda $ 为安全参数，$|\mathbb  {G}|$ 为群元素比特长度。本方案的额外符号：$M$ 为 QTree 叶子数（即授权用户总数上界），$\ell $ 为交叉标签（XTag）的维度，$k$ 为每次查询的采样位置数（$k \ll \ell $），$n$ 为合取查询中的关键词数，$|\mathsf  {Cand}|$ 为主关键词候选集规模（$|\mathsf  {Cand}| \leq |\mathsf  {Res}|$）。已有方案均针对单关键词或通用结果集验证，本方案针对多关键词合取查询中的资格检验与地址绑定两个阶段，验证对象与粒度不同，渐近表达式不可直接比较量级}}{7}{table.caption.6}\protected@file@percent }
